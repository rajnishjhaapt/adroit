# Production backend environment for Adroit (copy to /opt/adroit/backend/.env, chmod 600).
# Never commit the real file. Values below are placeholders.

# MongoDB on the VPS (see DEPLOYMENT.md step 3). Use the app user and password you created.
# Characters like @ : / # in the password must be URL-encoded (e.g. @ -> %40).
MONGO_URL=mongodb://adroit_app:CHANGE_ME_DB_PASSWORD@127.0.0.1:27017/adroit_prod?authSource=adroit_prod
DB_NAME=adroit_prod

# Your website origin(s), comma-separated, no trailing slash.
CORS_ORIGINS=https://www.your-domain.com,https://your-domain.com

# Admin login. Generate the hash with:  python3 scripts/make_admin_hash.py
ADMIN_EMAIL=caawdheshjha@gmail.com
ADMIN_PASSWORD_HASH=pbkdf2_sha256:600000:REPLACE_WITH_GENERATED_SALT:REPLACE_WITH_GENERATED_HASH
SESSION_HOURS=8

# Enquiry email alerts. Leave EMERGENT_EMAIL_KEY empty to turn alerts off.
EMAIL_FROM_NAME=Adroit Management and Tax Consultants
NOTIFY_EMAIL=caawdheshjha@gmail.com
EMERGENT_EMAIL_KEY=
